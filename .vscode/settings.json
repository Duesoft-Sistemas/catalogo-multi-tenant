{
  "css.validate": false,
  "less.validate": false,
  "scss.validate": false,
  "css.lint.unknownAtRules": "ignore",
  "tailwindCSS.includeLanguages": {
    "html": "html",
    "typescript": "typescript"
  },
  "tailwindCSS.experimental.classRegex": [
    ["ngClass\\s*=\\s*\\[([^\\]]*)\\]", "([^\\]]*)"],
    ["class\\s*=\\s*['\"`]([^'\"`]*)['\"`]", "([^'\"`]*)"]
  ],
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "emmet.includeLanguages": {
    "typescript": "html"
  }
} 